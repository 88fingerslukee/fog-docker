<VirtualHost *:{{FOG_APACHE_PORT}}>
    ServerName {{FOG_WEB_HOST}}
    DocumentRoot /var/www/html/fog
    
    # Reverse-proxy mode only: PHP must see HTTPS on the backend HTTP vhost.
    # Do not set on :80 for standard mode (HTTPS UI on :443, HTTP netboot on :80).
    {{#FOG_APACHE_SETENV_HTTPS_ON_HTTP_VHOST}}
    SetEnv HTTPS on
    {{/FOG_APACHE_SETENV_HTTPS_ON_HTTP_VHOST}}
    SetEnv FOG_STORAGE_NODE_SSH_HOST {{FOG_STORAGE_NODE_SSH_HOST}}

    # API basic auth: proxy_fcgi drops Authorization; SetEnvIf works under mod_php too.
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

    # Installer-only maintenance endpoints — same-machine only (upstream fog.conf).
    <LocationMatch "^{{FOG_WEB_ROOT_RE}}maintenance/">
        Require local
    </LocationMatch>
    
    <Directory /var/www/html/fog>
        Options +FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php index.html index.htm
    </Directory>

    # GH-529: Alias path is not covered by the real-tree Directory block alone.
    <Directory /var/www/html/fog/fog>
        Options +FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php index.html index.htm
    </Directory>
    
    # FOG specific configuration
    Alias {{FOG_WEB_ROOT}} /var/www/html/fog
    
    Timeout 600

    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
    RewriteRule .* - [F]
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_FILENAME} !-d
    RewriteRule ^{{FOG_WEB_ROOT_RE}}(.*)$ /var/www/html/fog/api/index.php [QSA,L]
    
    # Logging
    ErrorLog ${APACHE_LOG_DIR}/fog_error.log
    CustomLog ${APACHE_LOG_DIR}/fog_access.log combined
</VirtualHost>

{{#FOG_INTERNAL_HTTPS_ENABLED}}
<VirtualHost *:{{FOG_APACHE_SSL_PORT}}>
    ServerName {{FOG_WEB_HOST}}
    DocumentRoot /var/www/html/fog

    SetEnv FOG_STORAGE_NODE_SSH_HOST {{FOG_STORAGE_NODE_SSH_HOST}}
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1

    <LocationMatch "^{{FOG_WEB_ROOT_RE}}maintenance/">
        Require local
    </LocationMatch>
    
    <Directory /var/www/html/fog>
        Options +FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php index.html index.htm
    </Directory>

    <Directory /var/www/html/fog/fog>
        Options +FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php index.html index.htm
    </Directory>
    
    # FOG specific configuration
    Alias {{FOG_WEB_ROOT}} /var/www/html/fog
    
    Timeout 600

    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
    RewriteRule .* - [F]
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_FILENAME} !-f
    RewriteCond %{DOCUMENT_ROOT}/%{REQUEST_FILENAME} !-d
    RewriteRule ^{{FOG_WEB_ROOT_RE}}(.*)$ /var/www/html/fog/api/index.php [QSA,L]
    
    # SSL Configuration
    SSLEngine on
    SSLCertificateFile /opt/fog/snapins/ssl/{{FOG_APACHE_SSL_CERT_FILE}}
    SSLCertificateKeyFile /opt/fog/snapins/ssl/{{FOG_APACHE_SSL_KEY_FILE}}
    
    # Logging
    ErrorLog ${APACHE_LOG_DIR}/fog_ssl_error.log
    CustomLog ${APACHE_LOG_DIR}/fog_ssl_access.log combined
</VirtualHost>
{{/FOG_INTERNAL_HTTPS_ENABLED}}
